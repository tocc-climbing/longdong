            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "id": {
              "type": "string"
            },
            "t": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "props": {
          "type": "object"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "kind": {
          "const": "view"
        },
        "surface": {
          "const": "map"
        },
        "origin": {
          "enum": [
            "self",
            "authorized"
          ]
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      }
    },
    "layer": {
      "type": "object",
      "required": [
        "climbio",
        "kind",
        "id",
        "on",
        "t",
        "license"
      ],
      "properties": {
        "climbio": {
          "const": 2
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-z]{12,64}$"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "t": {
          "type": "integer",
          "minimum": 0
        },
        "author": {
          "type": "string"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "derivedFrom": {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "id": {
              "type": "string"
            },
            "t": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "props": {
          "type": "object"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "kind": {
          "const": "layer"
        },
        "on": {
          "type": "string",
          "pattern": "^[0-9a-z]{12,64}$"
        },
        "href": {
          "type": "string",
          "pattern": "^(https://\\S+|(?![/\\\\])(?!(.*/)?\\.\\.(/|$))[^\\s:\\\\#]+)$"
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      }
    },
    "set": {
      "type": "object",
      "required": [
        "climbio",
        "kind",
        "id",
        "t",
        "license"
      ],
      "properties": {
        "climbio": {
          "const": 2
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-z]{12,64}$"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "t": {
          "type": "integer",
          "minimum": 0
        },
        "author": {
          "type": "string"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "derivedFrom": {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "id": {
              "type": "string"
            },
            "t": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "props": {
          "type": "object"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "kind": {
          "const": "set"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "href"
            ],
            "properties": {
              "href": {
                "type": "string",
                "pattern": "^(https://\\S+|(?![/\\\\])(?!(.*/)?\\.\\.(/|$))[^\\s:\\\\#]+)$"
              },
              "id": {
                "type": "string",
                "pattern": "^[0-9a-z]{12,64}$"
              },
              "name": {
                "$ref": "#/$defs/text"
              },
              "t": {
                "type": "integer",
                "minimum": 0
              },
              "props": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
