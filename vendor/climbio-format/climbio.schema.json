{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Climbio open format",
  "oneOf": [
    {
      "$ref": "#/$defs/wall"
    },
    {
      "$ref": "#/$defs/topo"
    }
  ],
  "$defs": {
    "point": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "photo": {
      "type": "object",
      "required": [
        "href",
        "w",
        "h",
        "mime",
        "license",
        "attribution",
        "origin"
      ],
      "properties": {
        "href": {
          "type": "string",
          "pattern": "^(https://\\S+|(?![/\\\\])(?!(.*/)?\\.\\.(/|$))[^\\s:\\\\]+)$"
        },
        "w": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "h": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "mime": {
          "type": "string",
          "pattern": "^image/(jpeg|png|webp)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "type": "string"
        },
        "origin": {
          "enum": [
            "self",
            "authorized"
          ]
        }
      }
    },
    "derivedFrom": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "id": {
          "type": "string"
        },
        "t": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "hold": {
      "type": "object",
      "required": [
        "id",
        "poly"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "poly": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          },
          "minItems": 3
        },
        "source": {
          "enum": [
            "detect",
            "edited",
            "manual"
          ]
        },
        "t": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "route": {
      "type": "object",
      "required": [
        "id",
        "holds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-z]{1,40}$"
        },
        "name": {
          "type": "string"
        },
        "grade": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "t": {
          "type": "integer",
          "minimum": 0
        },
        "holds": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "s",
              "h",
              "f",
              "t"
            ]
          },
          "minProperties": 1
        },
        "seq": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shapes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/hold"
          }
        }
      }
    },
    "wall": {
      "type": "object",
      "required": [
        "climbio",
        "kind",
        "id",
        "name",
        "license",
        "t",
        "photo",
        "holds",
        "routes"
      ],
      "properties": {
        "climbio": {
          "const": 2
        },
        "kind": {
          "const": "wall"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-z]{8,40}$"
        },
        "name": {
          "type": "string"
        },
        "gym": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "t": {
          "type": "integer",
          "minimum": 0
        },
        "derivedFrom": {
          "$ref": "#/$defs/derivedFrom"
        },
        "thumb": {
          "type": "string",
          "pattern": "^(data:image/|$)"
        },
        "photo": {
          "$ref": "#/$defs/photo"
        },
        "holds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hold"
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/route"
          }
        }
      }
    },
    "topoRoute": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "grade": {
          "type": "string"
        },
        "line": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          },
          "minItems": 2
        },
        "bolts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/point"
          }
        }
      }
    },
    "position": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 3
    },
    "line": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "LineString"
            },
            "coordinates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/position"
              },
              "minItems": 2
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "MultiLineString"
            },
            "coordinates": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/position"
                },
                "minItems": 2
              },
              "minItems": 1
            }
          }
        }
      ]
    },
    "topo": {
      "type": "object",
      "required": [
        "climbio",
        "kind",
        "id",
        "name",
        "license",
        "t",
        "photo",
        "routes"
      ],
      "properties": {
        "climbio": {
          "const": 2
        },
        "kind": {
          "const": "topo"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "t": {
          "type": "integer",
          "minimum": 0
        },
        "derivedFrom": {
          "$ref": "#/$defs/derivedFrom"
        },
        "source": {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "sector": {
          "type": "string"
        },
        "photo": {
          "$ref": "#/$defs/photo"
        },
        "crop": {
          "type": "object",
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0
            },
            "y": {
              "type": "number",
              "minimum": 0
            },
            "w": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "h": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "routes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/topoRoute"
          }
        },
        "geo": {
          "type": "object",
          "properties": {
            "wall": {
              "$ref": "#/$defs/line"
            }
          }
        }
      }
    }
  }
}
