{
  "rules": {
    "v2": {
      "profiles": {
        ".read": true,
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!data.exists() || newData.exists() || newData.parent().parent().child('names').child(data.child('name').val().toLowerCase().replace('%', '%25').replace('.', '%2E').replace('$', '%24').replace('#', '%23').replace('[', '%5B').replace(']', '%5D').replace('/', '%2F')).val() !== $uid)",
          ".validate": "newData.hasChildren(['name', 'updatedAt'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30 && !newData.val().beginsWith(' ') && !newData.val().endsWith(' ') && !newData.val().contains('  ') && !newData.val().contains('\u200b') && !newData.val().contains('\u200c') && !newData.val().contains('\u200d') && !newData.val().contains('\u2060') && !newData.val().contains('\ufeff') && !newData.val().contains('\u3000') && !newData.val().contains('\u00a0') && !newData.val().matches(/[\uff01-\uff5e]/) && newData.parent().parent().parent().child('names').child(newData.val().toLowerCase().replace('%', '%25').replace('.', '%2E').replace('$', '%24').replace('#', '%23').replace('[', '%5B').replace(']', '%5D').replace('/', '%2F')).val() === $uid && (!data.exists() || data.val().toLowerCase().replace('%', '%25').replace('.', '%2E').replace('$', '%24').replace('#', '%23').replace('[', '%5B').replace(']', '%5D').replace('/', '%2F') === newData.val().toLowerCase().replace('%', '%25').replace('.', '%2E').replace('$', '%24').replace('#', '%23').replace('[', '%5B').replace(']', '%5D').replace('/', '%2F') || newData.parent().parent().parent().child('names').child(data.val().toLowerCase().replace('%', '%25').replace('.', '%2E').replace('$', '%24').replace('#', '%23').replace('[', '%5B').replace(']', '%5D').replace('/', '%2F')).val() !== $uid)"
          },
          "updatedAt": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$/)"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "names": {
        ".read": true,
        "$key": {
          ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.exists() && data.val() === auth.uid && !newData.exists()))",
          ".validate": "newData.isString() && newData.parent().parent().child('profiles').child(auth.uid).child('name').val().toLowerCase().replace('%', '%25').replace('.', '%2E').replace('$', '%24').replace('#', '%23').replace('[', '%5B').replace(']', '%5D').replace('/', '%2F') === $key"
        }
      },
      "ratings": {
        ".read": true,
        "$route": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || $route.matches(/^longdong:[2-9a-hjkmnp-z]{6}$/))",
            ".validate": "newData.hasChildren(['stars', 'updatedAt'])",
            "stars": {
              ".validate": "newData.val() === 1 || newData.val() === 2 || newData.val() === 3 || newData.val() === 4 || newData.val() === 5"
            },
            "feel": {
              ".validate": "newData.isString() && newData.val().matches(/^(soft|fair|hard)$/)"
            },
            "updatedAt": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "comments": {
        ".read": true,
        "$route": {
          "$id": {
            ".write": "auth != null && (!newData.exists() || $route.matches(/^longdong:[2-9a-hjkmnp-z]{6}$/)) && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && (auth != null && (root.child('role').child(auth.uid).exists() || (auth.token.email_verified === true && (auth.token.email === 'jinlung.you@gmail.com' || auth.token.email === 'maurice.chen67@gmail.com' || auth.token.email === 'kant.kang@gmail.com'))))))",
            ".validate": "newData.hasChildren(['uid', 'text', 'createdAt'])",
            "uid": {
              ".validate": "newData.isString()"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1000"
            },
            "createdAt": {
              ".validate": "newData.val() === now || (data.exists() && newData.val() === data.val())"
            },
            "hidden": {
              ".validate": "newData.isBoolean()"
            },
            "parent": {
              ".validate": "newData.isString() && root.child('v2').child('comments').child($route).child(newData.val()).exists() && !root.child('v2').child('comments').child($route).child(newData.val()).child('parent').exists()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "likes": {
        ".read": true,
        "$route": {
          "$comment": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && (!newData.exists() || ($route.matches(/^longdong:[2-9a-hjkmnp-z]{6}$/) && root.child('v2').child('comments').child($route).child($comment).exists()))",
              ".validate": "newData.val() === true"
            }
          }
        }
      },
      "reports": {
        ".read": "auth != null && (root.child('role').child(auth.uid).exists() || (auth.token.email_verified === true && (auth.token.email === 'jinlung.you@gmail.com' || auth.token.email === 'maurice.chen67@gmail.com' || auth.token.email === 'kant.kang@gmail.com')))",
        "$id": {
          ".write": "auth != null && (!data.exists() || (!newData.exists() && (auth != null && (root.child('role').child(auth.uid).exists() || (auth.token.email_verified === true && (auth.token.email === 'jinlung.you@gmail.com' || auth.token.email === 'maurice.chen67@gmail.com' || auth.token.email === 'kant.kang@gmail.com'))))))",
          ".validate": "newData.hasChildren(['path', 'uid', 'createdAt']) && newData.child('uid').val() === auth.uid",
          "path": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "uid": {
            ".validate": "newData.isString()"
          },
          "reason": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "createdAt": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "calibration": {
        ".read": "auth != null && (root.child('role').child(auth.uid).exists() || (auth.token.email_verified === true && (auth.token.email === 'jinlung.you@gmail.com' || auth.token.email === 'maurice.chen67@gmail.com' || auth.token.email === 'kant.kang@gmail.com')))",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && !newData.exists()",
          "$id": {
            ".write": "auth != null && auth.uid === $uid && (!data.exists() || !newData.exists())",
            ".validate": "newData.hasChildren(['geojson', 'createdAt'])",
            "geojson": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1000000"
            },
            "createdAt": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "reportPins": {
        ".read": "auth != null",
        "$key": {
          ".write": "(!data.exists() && newData.exists()) || (data.exists() && !newData.exists() && (auth != null && (root.child('role').child(auth.uid).exists() || (auth.token.email_verified === true && (auth.token.email === 'jinlung.you@gmail.com' || auth.token.email === 'maurice.chen67@gmail.com' || auth.token.email === 'kant.kang@gmail.com')))))",
          ".validate": "$key.matches(/^[0-9a-f]{32}$/) && newData.hasChildren(['lat', 'lng'])",
          "lat": { ".validate": "newData.isNumber() && newData.val() >= 25.08 && newData.val() <= 25.14" },
          "lng": { ".validate": "newData.isNumber() && newData.val() >= 121.89 && newData.val() <= 121.95" },
          "note": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "accuracy": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
          "picked": { ".validate": "newData.isString() && newData.val().matches(/^25\\.[0-9]{6},121\\.[0-9]{6}$/)" },
          "manual": { ".validate": "newData.val() === true" },
          "kind": { ".validate": "newData.val() === 'start' || newData.val() === 'rest' || newData.val() === 'top' || newData.val() === 'base'" },
          "area": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "sector": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "route": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "$other": { ".validate": false }
        }
      },
      "anonReports": {
        ".read": "auth != null && (root.child('role').child(auth.uid).exists() || (auth.token.email_verified === true && (auth.token.email === 'jinlung.you@gmail.com' || auth.token.email === 'maurice.chen67@gmail.com' || auth.token.email === 'kant.kang@gmail.com')))",
        "$device": {
          ".validate": "$device.matches(/^[0-9a-f-]{36}$/)",
          "$id": {
            ".write": "!data.exists()",
            ".validate": "newData.hasChildren(['geojson', 'createdAt'])",
            "geojson": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200000"
            },
            "createdAt": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "topos": {
        ".read": true,
        "$photo": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('uid').val() === auth.uid || (auth != null && (root.child('role').child(auth.uid).exists() || (auth.token.email_verified === true && (auth.token.email === 'jinlung.you@gmail.com' || auth.token.email === 'maurice.chen67@gmail.com' || auth.token.email === 'kant.kang@gmail.com')))))))",
          ".validate": "newData.hasChildren(['uid', 'sector', 'image', 'width', 'height', 'createdAt'])",
          "uid": {
            ".validate": "newData.isString()"
          },
          "sector": {
            ".validate": "newData.isString() && newData.val().matches(/^longdong\\/[a-z0-9-]{1,60}$/)"
          },
          "image": {
            ".validate": "newData.val() === 'topos/' + auth.uid + '/' + $photo + '.webp' || newData.val() === 'topos/' + auth.uid + '/' + $photo + '.jpg'"
          },
          "width": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 8192"
          },
          "height": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 8192"
          },
          "createdAt": {
            ".validate": "newData.val() === now"
          },
          "shot": {
            ".validate": "newData.hasChildren()",
            "lat": {
              ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
            },
            "lng": {
              ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
            },
            "accuracy": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "alpha": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 360"
            },
            "beta": {
              ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
            },
            "gamma": {
              ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
            },
            "absolute": {
              ".validate": "newData.isBoolean()"
            },
            "compass": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 360"
            },
            "compassAccuracy": {
              ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 360"
            },
            "time": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4102444800000"
            },
            "exifLat": {
              ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
            },
            "exifLng": {
              ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
            },
            "exifAlt": {
              ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 10000"
            },
            "exifHeading": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 360"
            },
            "exifHeadingRef": {
              ".validate": "newData.val() === 'T' || newData.val() === 'M'"
            },
            "make": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "model": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "focal35": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "topoEdits": {
        ".read": true,
        "$photo": {
          ".write": "auth != null && !newData.exists() && (root.child('v2').child('topos').child($photo).child('uid').val() === auth.uid || (auth != null && (root.child('role').child(auth.uid).exists() || (auth.token.email_verified === true && (auth.token.email === 'jinlung.you@gmail.com' || auth.token.email === 'maurice.chen67@gmail.com' || auth.token.email === 'kant.kang@gmail.com')))))",
          "$edit": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && root.child('v2').child('topos').child($photo).exists()) || (data.exists() && !newData.exists() && (data.child('uid').val() === auth.uid || (auth != null && (root.child('role').child(auth.uid).exists() || (auth.token.email_verified === true && (auth.token.email === 'jinlung.you@gmail.com' || auth.token.email === 'maurice.chen67@gmail.com' || auth.token.email === 'kant.kang@gmail.com')))))))",
            ".validate": "newData.hasChildren(['uid', 'createdAt', 'routes'])",
            "uid": {
              ".validate": "newData.isString()"
            },
            "createdAt": {
              ".validate": "newData.val() === now"
            },
            "routes": {
              "$route": {
                ".validate": "$route.matches(/^longdong:[2-9a-hjkmnp-z]{6}$/) && (newData.hasChild('line') || newData.hasChild('bolts'))",
                "line": {
                  ".validate": "newData.isString() && newData.val().length <= 1200 && newData.val().matches(/^[0-9]{1,5},[0-9]{1,5}( [0-9]{1,5},[0-9]{1,5})+$/)"
                },
                "bolts": {
                  "$position": {
                    ".validate": "$position.matches(/^[AB][0-9]{2}$/) && newData.isString() && newData.val().matches(/^[0-9]{1,5},[0-9]{1,5}$/)"
                  }
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "crop": {
              ".validate": "newData.hasChildren(['x', 'y', 'w', 'h']) && newData.child('x').val() + newData.child('w').val() <= 10000 && newData.child('y').val() + newData.child('h').val() <= 10000",
              "x": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000 && newData.val() % 1 === 0"
              },
              "y": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000 && newData.val() % 1 === 0"
              },
              "w": {
                ".validate": "newData.isNumber() && newData.val() >= 500 && newData.val() <= 10000 && newData.val() % 1 === 0"
              },
              "h": {
                ".validate": "newData.isNumber() && newData.val() >= 500 && newData.val() <= 10000 && newData.val() % 1 === 0"
              },
              "$other": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "walls": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && !newData.exists() && (auth.uid === $uid || (auth != null && (root.child('role').child(auth.uid).exists() || (auth.token.email_verified === true && (auth.token.email === 'jinlung.you@gmail.com' || auth.token.email === 'maurice.chen67@gmail.com' || auth.token.email === 'kant.kang@gmail.com')))))",
          "$wall": {
            ".write": "auth != null && ((!data.exists() && auth.uid === $uid) || (data.exists() && !newData.exists() && (auth.uid === $uid || (auth != null && (root.child('role').child(auth.uid).exists() || (auth.token.email_verified === true && (auth.token.email === 'jinlung.you@gmail.com' || auth.token.email === 'maurice.chen67@gmail.com' || auth.token.email === 'kant.kang@gmail.com')))))))",
            ".validate": "newData.hasChildren(['sector', 'line', 'createdAt'])",
            "sector": {
              ".validate": "newData.isString() && newData.val().matches(/^longdong\\/[a-z0-9-]{1,60}$/)"
            },
            "line": {
              ".validate": "newData.isString() && newData.val().length <= 2200 && newData.val().matches(/^25\\.[0-9]{6},121\\.[0-9]{6}( 25\\.[0-9]{6},121\\.[0-9]{6})+$/)"
            },
            "createdAt": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "mapEdits": {
        ".read": true,
        "$target": {
          ".write": "auth != null && !newData.exists() && (auth != null && (root.child('role').child(auth.uid).exists() || (auth.token.email_verified === true && (auth.token.email === 'jinlung.you@gmail.com' || auth.token.email === 'maurice.chen67@gmail.com' || auth.token.email === 'kant.kang@gmail.com'))))",
          ".validate": "$target.matches(/^(area:(school-gate|clocktower|long-lane|music-hall|grand-auditorium|first-cave|second-cave|golden-valley|back-door)|wall:longdong:[a-z0-9-]{1,60}|trails|highway|tunnel|road)$/)",
          "$version": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('uid').val() === auth.uid || (auth != null && (root.child('role').child(auth.uid).exists() || (auth.token.email_verified === true && (auth.token.email === 'jinlung.you@gmail.com' || auth.token.email === 'maurice.chen67@gmail.com' || auth.token.email === 'kant.kang@gmail.com')))))))",
            ".validate": "newData.hasChildren(['uid', 'createdAt']) && ($target.matches(/^(trails|highway|tunnel|road|wall:.*)$/) ? newData.hasChild('lines') && !newData.hasChild('rings') : newData.hasChild('rings') && !newData.hasChild('lines'))",
            "uid": {
              ".validate": "newData.isString()"
            },
            "createdAt": {
              ".validate": "newData.val() === now"
            },
            "rings": {
              ".validate": "newData.isString() && newData.val().length <= 30000 && (newData.val().matches(/^25\\.[0-9]{6},121\\.[0-9]{6}( 25\\.[0-9]{6},121\\.[0-9]{6}){2,}(\\|25\\.[0-9]{6},121\\.[0-9]{6}( 25\\.[0-9]{6},121\\.[0-9]{6}){2,})*$/))"
            },
            "lines": {
              ".validate": "newData.isString() && newData.val().length <= 100000 && (newData.val().matches(/^25\\.[0-9]{6},121\\.[0-9]{6}( 25\\.[0-9]{6},121\\.[0-9]{6})+(\\|25\\.[0-9]{6},121\\.[0-9]{6}( 25\\.[0-9]{6},121\\.[0-9]{6})+)*$/) || ($target.beginsWith('wall:') && newData.val() === ''))"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "textEdits": {
        ".read": true,
        "$target": {
          ".write": "auth != null && !newData.exists() && (auth != null && (root.child('role').child(auth.uid).exists() || (auth.token.email_verified === true && (auth.token.email === 'jinlung.you@gmail.com' || auth.token.email === 'maurice.chen67@gmail.com' || auth.token.email === 'kant.kang@gmail.com'))))",
          ".validate": "$target.matches(/^(area:(school-gate|clocktower|long-lane|music-hall|grand-auditorium|first-cave|second-cave|golden-valley|back-door)|route:longdong:[2-9a-hjkmnp-z]{6})$/)",
          "$version": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('uid').val() === auth.uid || (auth != null && (root.child('role').child(auth.uid).exists() || (auth.token.email_verified === true && (auth.token.email === 'jinlung.you@gmail.com' || auth.token.email === 'maurice.chen67@gmail.com' || auth.token.email === 'kant.kang@gmail.com')))))))",
            ".validate": "newData.hasChildren(['uid', 'createdAt', 'text'])",
            "uid": {
              ".validate": "newData.isString()"
            },
            "createdAt": {
              ".validate": "newData.val() === now"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 3000"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "personal": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          "favorites": {
            "$key": {
              ".validate": "newData.hasChildren(['routeId', 'createdAt', 'updatedAt']) && newData.child('routeId').isString() && newData.child('routeId').val().length <= 100 && newData.child('updatedAt').isString()"
            }
          },
          "best": {
            "$key": {
              ".validate": "newData.hasChildren(['routeId', 'style', 'createdAt', 'updatedAt']) && newData.child('routeId').isString() && newData.child('routeId').val().length <= 100 && newData.child('style').val().matches(/^(onsight|flash|redpoint|toprope)$/) && newData.child('updatedAt').isString() && (!newData.child('deleted').exists() || newData.child('deleted').isBoolean())"
            }
          },
          "ticks": {
            "$id": {
              ".validate": "newData.hasChildren(['id', 'routeId', 'date', 'style', 'createdAt', 'updatedAt']) && newData.child('id').val() === $id && newData.child('routeId').isString() && newData.child('routeId').val().length <= 100 && newData.child('date').val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.child('style').val().matches(/^(onsight|flash|redpoint|follow|toprope|attempt)$/) && (!newData.child('note').exists() || (newData.child('note').isString() && newData.child('note').val().length <= 1000))"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "role": {
      ".read": true
    }
  }
}
