{
  "rules": {
    "v2": {
      "profiles": {
        ".read": true,
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['name', 'updatedAt'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30 && !newData.val().beginsWith(' ') && !newData.val().endsWith(' ') && !newData.val().contains('  ') && !newData.val().contains('\u200b') && !newData.val().contains('\u200c') && !newData.val().contains('\u200d') && !newData.val().contains('\u2060') && !newData.val().contains('\ufeff') && !newData.val().contains('\u3000') && !newData.val().contains('\u00a0') && !newData.val().matches(/[\uff01-\uff5e]/) && newData.parent().parent().parent().child('names').child(newData.val().toLowerCase().replace('%', '%25').replace('.', '%2E').replace('$', '%24').replace('#', '%23').replace('[', '%5B').replace(']', '%5D').replace('/', '%2F')).val() === $uid && (!data.exists() || data.val().toLowerCase().replace('%', '%25').replace('.', '%2E').replace('$', '%24').replace('#', '%23').replace('[', '%5B').replace(']', '%5D').replace('/', '%2F') === newData.val().toLowerCase().replace('%', '%25').replace('.', '%2E').replace('$', '%24').replace('#', '%23').replace('[', '%5B').replace(']', '%5D').replace('/', '%2F') || newData.parent().parent().parent().child('names').child(data.val().toLowerCase().replace('%', '%25').replace('.', '%2E').replace('$', '%24').replace('#', '%23').replace('[', '%5B').replace(']', '%5D').replace('/', '%2F')).val() !== $uid)"
          },
          "updatedAt": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$/)"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "names": {
        ".read": true,
        "$key": {
          ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.exists() && data.val() === auth.uid && !newData.exists()))",
          ".validate": "newData.isString() && newData.parent().parent().child('profiles').child(auth.uid).child('name').val().toLowerCase().replace('%', '%25').replace('.', '%2E').replace('$', '%24').replace('#', '%23').replace('[', '%5B').replace(']', '%5D').replace('/', '%2F') === $key"
        }
      },
      "ratings": {
        ".read": true,
        "$route": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $route.length <= 100",
            ".validate": "newData.hasChildren(['stars', 'updatedAt'])",
            "stars": {
              ".validate": "newData.val() === 1 || newData.val() === 2 || newData.val() === 3 || newData.val() === 4 || newData.val() === 5"
            },
            "feel": {
              ".validate": "newData.isString() && newData.val().matches(/^(soft|fair|hard)$/)"
            },
            "updatedAt": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "comments": {
        ".read": true,
        "$route": {
          "$id": {
            ".write": "auth != null && $route.length <= 100 && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() === auth.uid))",
            ".validate": "newData.hasChildren(['uid', 'text', 'createdAt'])",
            "uid": {
              ".validate": "newData.isString()"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1000"
            },
            "createdAt": {
              ".validate": "newData.val() === now || (data.exists() && newData.val() === data.val())"
            },
            "hidden": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "reports": {
        ".read": "auth != null && root.child('role').child(auth.uid).exists()",
        "$id": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.hasChildren(['path', 'uid', 'createdAt']) && newData.child('uid').val() === auth.uid",
          "path": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "uid": {
            ".validate": "newData.isString()"
          },
          "reason": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "createdAt": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "calibration": {
        ".read": "auth != null && root.child('role').child(auth.uid).exists()",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && !newData.exists()",
          "$id": {
            ".write": "auth != null && auth.uid === $uid && (!data.exists() || !newData.exists())",
            ".validate": "newData.hasChildren(['geojson', 'createdAt'])",
            "geojson": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1000000"
            },
            "createdAt": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "anonReports": {
        ".read": "auth != null && root.child('role').child(auth.uid).exists()",
        "$device": {
          ".validate": "$device.matches(/^[0-9a-f-]{36}$/)",
          "$id": {
            ".write": "!data.exists()",
            ".validate": "newData.hasChildren(['geojson', 'createdAt'])",
            "geojson": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200000"
            },
            "createdAt": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "personal": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          "favorites": {
            "$key": {
              ".validate": "newData.hasChildren(['routeId', 'createdAt', 'updatedAt']) && newData.child('routeId').isString() && newData.child('routeId').val().length <= 100 && newData.child('updatedAt').isString()"
            }
          },
          "best": {
            "$key": {
              ".validate": "newData.hasChildren(['routeId', 'style', 'createdAt', 'updatedAt']) && newData.child('routeId').isString() && newData.child('routeId').val().length <= 100 && newData.child('style').val().matches(/^(onsight|flash|redpoint|toprope)$/) && newData.child('updatedAt').isString() && (!newData.child('deleted').exists() || newData.child('deleted').isBoolean())"
            }
          },
          "ticks": {
            "$id": {
              ".validate": "newData.hasChildren(['id', 'routeId', 'date', 'style', 'createdAt', 'updatedAt']) && newData.child('id').val() === $id && newData.child('routeId').isString() && newData.child('routeId').val().length <= 100 && newData.child('date').val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.child('style').val().matches(/^(onsight|flash|redpoint|follow|toprope|attempt)$/) && (!newData.child('note').exists() || (newData.child('note').isString() && newData.child('note').val().length <= 1000))"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "role": {
      ".read": true
    },
    "topos": {
      ".read": true
    }
  }
}
