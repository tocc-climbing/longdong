{
  "name": "longdong-app",
  "version": "1.0.0",
  "private": true,
  "description": "龍洞攀岩路線資料庫 — offline-first PWA",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/gen-share-pages.ts",
    "preview": "vite preview",
    "import": "tsx scripts/import-sheet.ts",
    "scale-map": "tsx scripts/gen-scale-map.ts",
    "crag-edges": "tsx scripts/gen-crag-edges.ts",
    "test": "vitest run",
    "check:text": "tsx scripts/check-text-overflow.ts",
    "shots": "tsx scripts/shots.ts",
    "test:e2e": "vite build --mode e2e --outDir dist-e2e && npx -y firebase-tools@15.34.1 emulators:exec --config firebase.e2e.json --only auth,database,storage --project demo-longdong \"tsx scripts/e2e-report.ts && tsx scripts/e2e-edit.ts\"",
    "test:rules": "npx -y firebase-tools@15.34.1 emulators:exec --only database,storage --project demo-longdong \"vitest run --config vitest.rules.config.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "idb": "^8.0.4",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@napi-rs/canvas": "^1.0.13",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
