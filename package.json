{
  "name": "longdong-app",
  "version": "1.0.0",
  "private": true,
  "description": "龍洞攀岩路線資料庫 — offline-first PWA",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/gen-share-pages.ts",
    "preview": "vite preview",
    "import": "tsx scripts/import-sheet.ts",
    "rescue-map": "tsx scripts/gen-rescue-map.ts",
    "scale-map": "tsx scripts/gen-scale-map.ts",
    "test": "vitest run",
    "check:text": "tsx scripts/check-text-overflow.ts",
    "test:e2e": "vite build --mode e2e --outDir dist-e2e && npx -y firebase-tools@15.33.0 emulators:exec --config firebase.e2e.json --only auth,database --project demo-longdong \"tsx scripts/e2e-report.ts\"",
    "test:rules": "npx -y firebase-tools@15.33.0 emulators:exec --only database --project demo-longdong \"vitest run --config vitest.rules.config.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "idb": "^8.0.4",
    "minisearch": "^7.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@napi-rs/canvas": "^1.0.11",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.19.43",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.5",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "zod": "^3.25.76"
  }
}
